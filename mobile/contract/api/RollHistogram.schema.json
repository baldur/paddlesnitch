{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "RollHistogram.schema.json",
  "type": "object",
  "properties": {
    "binWidthDeg": {
      "type": "number"
    },
    "bins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "centreDeg": {
            "type": "number"
          },
          "count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "centreDeg",
          "count"
        ]
      }
    }
  },
  "required": [
    "binWidthDeg",
    "bins"
  ]
}
