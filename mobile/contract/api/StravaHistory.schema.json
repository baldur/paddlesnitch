{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "StravaHistory.schema.json",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "not_connected",
        "rate_limited"
      ]
    },
    "toImport": {
      "type": "array",
      "items": {
        "$ref": "HistoryPaddle.schema.json"
      }
    },
    "alreadyIn": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "firstImportDone": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "firstImportDone"
  ]
}
