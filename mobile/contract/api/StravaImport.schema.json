{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "StravaImport.schema.json",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "imported",
        "duplicate",
        "skipped"
      ]
    },
    "sessionId": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "no_tokens",
        "not_water_sport",
        "no_track",
        "rate_limited"
      ]
    }
  },
  "required": [
    "status"
  ]
}
