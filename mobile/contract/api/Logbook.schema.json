{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Logbook.schema.json",
  "type": "object",
  "properties": {
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "km": {
            "type": "number"
          }
        },
        "required": [
          "week",
          "km"
        ]
      }
    },
    "streakWeeks": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "thisMonthKm": {
      "type": "number"
    },
    "lastMonthKm": {
      "type": "number"
    }
  },
  "required": [
    "weeks",
    "streakWeeks",
    "thisMonthKm",
    "lastMonthKm"
  ]
}
