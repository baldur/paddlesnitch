{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "AnalysisSession.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "paddledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source": {
      "$ref": "AnalysisSource.schema.json"
    },
    "doubleStrokeRate": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "insight": {
      "type": "string"
    },
    "result": {
      "$ref": "AnalysisResult.schema.json"
    },
    "boatClass": {
      "allOf": [
        {
          "$ref": "BoatClass.schema.json"
        }
      ]
    },
    "seat": {
      "allOf": [
        {
          "$ref": "Seat.schema.json"
        }
      ]
    },
    "shareId": {
      "type": "string"
    },
    "insightPending": {
      "type": "boolean",
      "const": true
    },
    "hiddenFromBuddies": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "id",
    "userId",
    "createdAt",
    "paddledAt",
    "source",
    "doubleStrokeRate",
    "note",
    "insight",
    "result"
  ]
}
