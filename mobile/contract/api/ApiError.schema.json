{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ApiError.schema.json",
  "type": "object",
  "properties": {
    "error": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "reauth": {
      "type": "boolean",
      "const": true
    },
    "needsCode": {
      "type": "boolean",
      "const": true
    },
    "accountDeleted": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "error"
  ]
}
