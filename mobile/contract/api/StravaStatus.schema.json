{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "StravaStatus.schema.json",
  "type": "object",
  "properties": {
    "connected": {
      "type": "boolean"
    },
    "athlete": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "autoImport": {
      "type": "boolean"
    }
  },
  "required": [
    "connected"
  ]
}
