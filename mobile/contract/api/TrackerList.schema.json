{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "TrackerList.schema.json",
  "type": "object",
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "$ref": "Tracker.schema.json"
      }
    },
    "stableVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "summaries": {
      "type": "array",
      "items": {
        "$ref": "TrackerSummary.schema.json"
      }
    }
  },
  "required": [
    "devices",
    "stableVersion",
    "summaries"
  ]
}
