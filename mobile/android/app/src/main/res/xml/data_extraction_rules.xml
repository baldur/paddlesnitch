<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" stops cloud backup; on Android 12+ a phone-to-phone
     transfer still copies app files unless these rules say otherwise.
     Recordings are where someone paddles: they stay on the phone that made them.
     phone.xml holds this install's id (C3): a new phone is a new install, never
     a copy of the old one on the account. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="recordings/" />
        <exclude domain="sharedpref" path="phone.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="recordings/" />
        <exclude domain="sharedpref" path="phone.xml" />
    </device-transfer>
</data-extraction-rules>
