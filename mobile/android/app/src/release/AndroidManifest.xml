<?xml version="1.0" encoding="utf-8"?>
<!-- Release asks for no location (checkReleasePermissions in app/build.gradle.kts).
     The map library declares these, and the app never shows the phone's own
     place on a map. Phone recording declares its own when it ships (#761). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
</manifest>
