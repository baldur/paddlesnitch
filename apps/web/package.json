{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "cognito": "cognito-local",
    "cognito:init": "tsx --env-file-if-exists=.env.local scripts/cognito-init.ts",
    "rivers": "tsx scripts/download-rivers.ts",
    "build:open-next": "npx open-next build",
    "deploy": "pnpm build:open-next && cd ../../infra && npm run deploy",
    "strava:webhook": "tsx scripts/strava-webhook.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1141.0",
    "@paddlesnitch/analysis": "workspace:*",
    "@paddlesnitch/api": "workspace:*",
    "@paddlesnitch/core": "workspace:*",
    "@paddlesnitch/timing": "workspace:*",
    "@paddlesnitch/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "zod": "^4.6.5",
    "@aws-sdk/client-cognito-identity-provider": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-ses": "^3.1141.0",
    "@aws-sdk/client-ssm": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@swc/helpers": "^0.5.23",
    "aws-jwt-verify": "^5.2.1",
    "fit-file-parser": "^3.1.3",
    "leaflet": "^1.9.4",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@opennextjs/aws": "^4.1.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-leaflet": "^3.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cognito-local": "^5.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
